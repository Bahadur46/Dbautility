# ---- Server ----
PORT=5000
NODE_ENV=development

# ---- Database ----
MONGODB_URI=mongodb+srv://bahadur3028_db_user:HDTiC60Z7wBPxaey@clusterdhs.c0ai6pq.mongodb.net/dba_utility?retryWrites=true&w=majority
# MongoDB Atlas example:
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/dba_utility?retryWrites=true&w=majority

# ---- CORS ----
CORS_ORIGIN=https://dba.erpthemes.com,http://dba.erpthemes.com,http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176,http://localhost:4173

# ---- Rate limiting ----
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000

# ---- Default user context ----
DEFAULT_USER_ID=u-1001
DEFAULT_USER_NAME=System Administrator

# ---- Fallback ----
# When the MongoDB above cannot be reached, start on a temporary in-memory
# database so the app still runs (development only; never in production).
# Set to false to make an unreachable database stop the boot instead.
ALLOW_INMEMORY_FALLBACK=true

# ---- Audit ----
# VIEW entries record no change and are by far the most numerous.
# false = do not record them at all. CREATE, UPDATE and DELETE are unaffected.
LOG_VIEW_ACTIONS=false

# ---- Clusters ----
# Every cluster is reached over the connection string above (MONGODB_URI) with
# only the database swapped, and CLUSTER_<KEY>_DB names that database. It holds
# the cluster's own data — its manual index definitions.
#
# LOGIN IS NOT PER CLUSTER. The accounts (LoginTB) and the sign-in history
# beside them live only in the database MONGODB_URI names (dba_utility), so
# there is one username and one password for the whole deployment. The cluster
# is chosen AFTER signing in, inside the app, and can be switched there without
# signing in again. The audit trail is shared in that database too.
# Point a cluster at a different server entirely with CLUSTER_<KEY>_URI.
CLUSTER_ANANDA_DB=dba_ananda
CLUSTER_DOTIN_DB=dba_dotin
CLUSTER_COLSTON_DB=dba_colston
CLUSTER_KAMDHENU_DB=dba_kamdhenu

# A separate MongoDB server for a cluster's OWN records — accounts, index
# definitions, audit trail (leave blank to use MONGODB_URI).
CLUSTER_ANANDA_URI=
CLUSTER_DOTIN_URI=
CLUSTER_COLSTON_URI=
CLUSTER_KAMDHENU_URI=

# Optional — only when the database indexes are applied to differs from the
# one named above.
CLUSTER_ANANDA_TARGET_DB=
CLUSTER_DOTIN_TARGET_DB=
CLUSTER_COLSTON_TARGET_DB=
CLUSTER_KAMDHENU_TARGET_DB=

# The server a cluster's indexes are created on, when it is not the server its
# own records live on. The application writes nothing of its own here — no
# accounts, no index definitions, no audit trail — it only reads the databases
# and creates the indexes it is asked for.
CLUSTER_ANANDA_DATA_URI=
CLUSTER_DOTIN_DATA_URI=
CLUSTER_COLSTON_DATA_URI=mongodb+srv://colstonbathindia:Poptnfn2175det@colstoncluster.3ggrl.mongodb.net/
CLUSTER_KAMDHENU_DATA_URI=mongodb+srv://adminuser_db_user:NIM3lV6tj7X7ym8Jdet@ClusterKamdhenuNew.x3jsp4.mongodb.net/ERP_40019


# ---- Auth ----
# Fixed signing secret. Without it a new random secret is generated on every
# boot, so every restart signs all users out ("Your session has ended").
AUTH_SECRET=1eeac4e78e162d85d5da186679c9a8c5c9a087982c5b3bc95f45314940c31d0a
