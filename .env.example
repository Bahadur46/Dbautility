# ---- Server ----
PORT=5000
NODE_ENV=development

# ---- Database ----
# Local MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/dba_utility
# MongoDB Atlas example (never commit real credentials to this file):
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/dba_utility?retryWrites=true&w=majority

# ---- Target database ----
# Which database indexes are created on. Leave empty to use the database in
# MONGODB_URI. Each Manual Index can also name its own database in the form,
# which overrides this.
TARGET_DB=

# ---------------------------------------------------------------------------
# Clusters
# ---------------------------------------------------------------------------
# Sign-in is cluster-wise: the login form shows these, and a session only ever
# reads and writes the cluster it was issued for. Each cluster keeps its OWN
# login accounts (LoginTB), sign-in history, manual indexes and audit trail in
# its own database, so credentials created for one cluster do not work on
# another. By default every cluster is reached over MONGODB_URI above with just
# the database name swapped, so they share one server while staying separate
# databases.
CLUSTER_ANANDA_DB=dba_ananda
CLUSTER_DOTIN_DB=dba_dotin
CLUSTER_COLSTON_DB=dba_colston
CLUSTER_KAMDHENU_DB=dba_kamdhenu

# Set only when a cluster's OWN records — accounts, index definitions, audit
# trail — live on a different MongoDB server. Blank means "use MONGODB_URI with
# the database above".
CLUSTER_ANANDA_URI=
CLUSTER_DOTIN_URI=
CLUSTER_COLSTON_URI=
CLUSTER_KAMDHENU_URI=

# The server a cluster's indexes are created on, when that is not the server
# holding its own records. The application writes nothing of its own here: it
# only reads the databases and creates the indexes it is asked for, so a
# production data server keeps no DBA Utility collections at all.
CLUSTER_ANANDA_DATA_URI=
CLUSTER_DOTIN_DATA_URI=
CLUSTER_COLSTON_DATA_URI=
CLUSTER_KAMDHENU_DATA_URI=

# Optional per-cluster override of TARGET_DB — the database indexes are
# applied to, when it differs from the one in the connection string.
CLUSTER_ANANDA_TARGET_DB=
CLUSTER_DOTIN_TARGET_DB=
CLUSTER_COLSTON_TARGET_DB=
CLUSTER_KAMDHENU_TARGET_DB=

# ---- Audit ----
# VIEW entries are by far the most numerous and record no change. Set to false
# to stop recording them; CREATE, UPDATE and DELETE keep their full trail.
LOG_VIEW_ACTIONS=true

# ---- CORS ----
# Comma separated list of allowed frontend origins
# In development any http://localhost:<port> is accepted as well, so a Vite
# server that lands on 5174 instead of 5173 still works.
CORS_ORIGIN=https://dba.erpthemes.com,http://localhost:5173

# ---- Rate limiting ----
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000

# ---- Default user context (used when the client sends no user headers) ----
DEFAULT_USER_ID=u-1001
DEFAULT_USER_NAME=System Administrator

# ---- Fallback ----
# When the MongoDB above cannot be reached, start on a temporary in-memory
# database so the app still runs (development only; never in production).
# Set to false to make an unreachable database stop the boot instead.
ALLOW_INMEMORY_FALLBACK=true

# ---- Authentication ----
# Signs the session tokens issued by POST /api/auth/login. Leave empty in
# development (a random secret is generated per start, which logs everyone out
# on restart); REQUIRED in production.
AUTH_SECRET=
# How long a session token stays valid. Default 8 hours.
AUTH_TOKEN_TTL_MS=28800000

# The one administrator created on first boot, in the central LoginTB, able to
# sign in to every cluster. It only bootstraps the console: once it is running,
# accounts are added and edited on the Users page, and an account edited there
# stops being overwritten from here. The password is read once; after that it
# lives hashed in the database and changes via /api/auth/change-password.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@123
ADMIN_USER_NAME=System Administrator
ADMIN_USER_ID=u-1001
